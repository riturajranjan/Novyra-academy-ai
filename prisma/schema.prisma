generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- Auth (Auth.js v5 PrismaAdapter-compatible; wired up in Phase 2) ---

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  onboardingProfile   OnboardingProfile?
  passwordResetTokens PasswordResetToken[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// --- Content taxonomy (mirrors src/constants/{boards,classes,subjects,learningStyles,targetScores,dailyGoals}.ts) ---

model Board {
  id       String   @id
  title    String
  subtitle String
  badge    String?
  icon     String
  features String[]

  onboardingProfiles OnboardingProfile[]
  classes            BoardClass[]
  subjects           BoardClassSubject[]
}

model SchoolClass {
  id           Int     @id
  title        String
  subtitle     String
  chapterCount Int
  subjectCount Int
  streamCount  Int?
  personalized Boolean @default(false)

  onboardingProfiles OnboardingProfile[]
  boards             BoardClass[]
  subjects           BoardClassSubject[]
}

model Subject {
  id           Int     @id
  title        String
  description  String
  chapterCount Int
  level        String
  badge        String?
  icon         String

  onboardingProfiles UserSubject[]
  boardClasses       BoardClassSubject[]
}

// Which classes a board offers.
model BoardClass {
  boardId String
  classId Int

  board       Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  schoolClass SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@id([boardId, classId])
}

// Which subjects a board+class combination offers.
model BoardClassSubject {
  boardId   String
  classId   Int
  subjectId Int

  board       Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  schoolClass SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject     Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([boardId, classId, subjectId])
}

model LearningStyle {
  id          String @id
  title       String
  description String
  icon        String
  color       String

  onboardingProfiles UserLearningStyle[]
}

model TargetScore {
  id    Int    @id
  score String
  title String
  desc  String

  onboardingProfiles OnboardingProfile[]
}

model DailyGoal {
  id       String @id
  title    String
  duration String
  icon     String

  onboardingProfiles OnboardingProfile[]
}

// --- Per-user onboarding selections ---

model OnboardingProfile {
  id            String    @id @default(cuid())
  userId        String    @unique
  boardId       String?
  classId       Int?
  targetScoreId Int?
  dailyGoalId   String?
  examDate      DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  board          Board?              @relation(fields: [boardId], references: [id])
  schoolClass    SchoolClass?        @relation(fields: [classId], references: [id])
  targetScore    TargetScore?        @relation(fields: [targetScoreId], references: [id])
  dailyGoal      DailyGoal?          @relation(fields: [dailyGoalId], references: [id])
  subjects       UserSubject[]
  learningStyles UserLearningStyle[]
}

model UserSubject {
  onboardingProfileId String
  subjectId           Int

  onboardingProfile OnboardingProfile @relation(fields: [onboardingProfileId], references: [id], onDelete: Cascade)
  subject           Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([onboardingProfileId, subjectId])
}

model UserLearningStyle {
  onboardingProfileId String
  learningStyleId     String

  onboardingProfile OnboardingProfile @relation(fields: [onboardingProfileId], references: [id], onDelete: Cascade)
  learningStyle     LearningStyle     @relation(fields: [learningStyleId], references: [id], onDelete: Cascade)

  @@id([onboardingProfileId, learningStyleId])
}
