# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# Neon connection strings: https://neon.tech/docs/guides/prisma
# DATABASE_URL uses Neon's pooled connection (via PgBouncer) for the running app.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&pgbouncer=true"
# DIRECT_URL uses Neon's unpooled connection, required by Prisma for migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Auth.js v5 — generate with: openssl rand -base64 32
AUTH_SECRET=""

# Base URL used to build links (e.g. the password-reset link logged to the console).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
